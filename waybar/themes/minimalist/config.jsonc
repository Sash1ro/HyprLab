// -*- mode: jsonc -*-
{
  //INIT
  "include": "~/.config/hyprlab/waybar/modules",
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "spacing": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-top": 0,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  // MODULES POSITIONS
  "modules-left": ["custom/icon", "hyprland/workspaces", "custom/media"],
  "modules-center": ["group/middle"],
  "modules-right": ["group/right"],

  "hyprland/workspaces": {
    "rotate": 0,
    "all-outputs": false,
    "active-only": false,
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace -1",
    "on-scroll-down": "hyprctl dispatch workspace +1",
    "format": "{icon}",
    "format-icons": {
		//"active": "",
    "visible": "",
		"default": "",
    "special": "{name}"
	}
  },

  "group/right": {
    "orientation": "horizontal",
    "modules": [
      "custom/record",
      "group/traybox",
      "bluetooth",
      "network",
      "pulseaudio",
      "custom/notification",
      "custom/exit"
    ]
  },

  "group/perfs": {
    "orientation": "horizontal",
    "modules": ["cpu#icon", "cpu", "memory#icon", "memory"]
  },

  "group/drawer-perfs": {
    "orientation": "horizontal",
    "drawer": {
      "transition-left-to-right": true,
      "transition-duration": 300,
      "children-class": "element"
    },
    "modules": ["custom/perf-icon", "group/perfs"]
  },

  "group/middle": {
    "orientation": "horizontal",
    "modules": ["clock", "group/drawer-perfs"]
  }
}
