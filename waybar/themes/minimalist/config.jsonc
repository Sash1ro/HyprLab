// -*- mode: jsonc -*-
{
  //INIT
  "include": "~/.config/hyprlab/waybar/modules",
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "spacing": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-top": 0,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  // MODULES POSITIONS
  "modules-left": ["custom/icon", "hyprland/workspaces", "custom/media"],
  "modules-center": ["clock"],
  "modules-right": ["group/right"]
}
