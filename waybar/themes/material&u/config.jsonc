// -*- mode: jsonc -*-
{
  //INIT
  "include": "~/.config/hyprlab/waybar/modules",
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "spacing": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-top": 0,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  // MODULES POSITIONS
  "modules-left": ["custom/icon", "custom/media"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["group/perfs", "group/right", "group/middle"],

  "clock": {
    "format": "{:%H:%M}",
    "timezone": "Europe/Paris",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%d-%m-%Y}"
  },

  "group/right": {
    "orientation": "horizontal",
    "modules": [
      "custom/record",
      "group/traybox",
      "bluetooth",
      "network",
      "pulseaudio",
      "custom/notification"
    ]
  },

   "hyprland/workspaces": {
    "rotate": 0,
    "all-outputs": false,
    "active-only": false,
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace -1",
    "on-scroll-down": "hyprctl dispatch workspace +1",
    "format": "{icon}",
    "format-icons": {
		//"active": "",
    "visible": "",
		"default": "",
    "special": ""
	}
  },

  "group/perfs": {
    "orientation": "horizontal",
    "modules": ["cpu#icon", "cpu", "memory#icon", "memory"]
  },

  "group/middle": {
    "orientation": "horizontal",
    "modules": ["clock", "custom/exit"]
  }
}
