* {
  primary: #acc7ff;
  primary-fixed: #d7e2ff;
  primary-fixed-dim: #acc7ff;
  on-primary: #0f2f60;
  on-primary-fixed: #001a40;
  on-primary-fixed-variant: #2a4678;
  primary-container: #2a4678;
  on-primary-container: #d7e2ff;
  secondary: #bec6dc;
  secondary-fixed: #dae2f9;
  secondary-fixed-dim: #bec6dc;
  on-secondary: #283041;
  on-secondary-fixed: #131c2c;
  on-secondary-fixed-variant: #3f4759;
  secondary-container: #3f4759;
  on-secondary-container: #dae2f9;
  tertiary: #debcdf;
  tertiary-fixed: #fbd7fc;
  tertiary-fixed-dim: #debcdf;
  on-tertiary: #402844;
  on-tertiary-fixed: #29132d;
  on-tertiary-fixed-variant: #583e5b;
  tertiary-container: #583e5b;
  on-tertiary-container: #fbd7fc;
  error: #ffb4ab;
  on-error: #690005;
  error-container: #93000a;
  on-error-container: #ffdad6;
  surface: #111318;
  on-surface: #e2e2e9;
  on-surface-variant: #c4c6d0;
  outline: #8e9099;
  outline-variant: #44474f;
  shadow: #000000;
  scrim: #000000;
  inverse-surface: #e2e2e9;
  inverse-on-surface: #2f3036;
  inverse-primary: #435e91;
  surface-dim: #111318;
  surface-bright: #37393e;
  surface-container-lowest: #0c0e13;
  surface-container-low: #1a1b20;
  surface-container: #1e2025;
  surface-container-high: #282a2f;
  surface-container-highest: #33353a;

  background:                 @surface-container-highest;
  trans-bg: rgba(30, 32, 37, 0.75);
  foreground:                 @on-surface;
  background-color:           transparent;
  alt-foreground: @on-primary;
  main: @primary;
  red: @error;
  lightfg:                  @on-surface-variant;
  lightbg:                    @surface-bright;
  border-color:               @outline-variant;

  normal-foreground:          @foreground;
  normal-background:          transparent;

  selected-normal-foreground: @alt-foreground;
  selected-normal-background: @main;

  selected-active-foreground: @alt-foreground;
  selected-active-background: @main;

  selected-urgent-foreground: @background;
  selected-urgent-background: @red;

  active-foreground:          @main;
  active-background:          @background;

  urgent-foreground:          @red;
  urgent-background:          @background;

  alternate-normal-foreground: @foreground;
  alternate-normal-background: transparent;

  alternate-active-foreground: @main;
  alternate-active-background: @main;

  alternate-urgent-foreground: @red;
  alternate-urgent-background: @lightbg;

  separatorcolor:             @main;

}
