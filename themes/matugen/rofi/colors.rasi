* {
  primary: #deb8f7;
  primary-fixed: #f2daff;
  primary-fixed-dim: #deb8f7;
  on-primary: #402357;
  on-primary-fixed: #2a0c40;
  on-primary-fixed-variant: #583a6f;
  primary-container: #583a6f;
  on-primary-container: #f2daff;
  secondary: #d2c1d9;
  secondary-fixed: #eeddf5;
  secondary-fixed-dim: #d2c1d9;
  on-secondary: #372c3f;
  on-secondary-fixed: #221829;
  on-secondary-fixed-variant: #4e4256;
  secondary-container: #4e4256;
  on-secondary-container: #eeddf5;
  tertiary: #f4b7bb;
  tertiary-fixed: #ffdadb;
  tertiary-fixed-dim: #f4b7bb;
  on-tertiary: #4c2529;
  on-tertiary-fixed: #321015;
  on-tertiary-fixed-variant: #663b3e;
  tertiary-container: #663b3e;
  on-tertiary-container: #ffdadb;
  error: #ffb4ab;
  on-error: #690005;
  error-container: #93000a;
  on-error-container: #ffdad6;
  surface: #161217;
  on-surface: #e8e0e8;
  on-surface-variant: #cdc3ce;
  outline: #968e98;
  outline-variant: #4b454d;
  shadow: #000000;
  scrim: #000000;
  inverse-surface: #e8e0e8;
  inverse-on-surface: #332f35;
  inverse-primary: #715188;
  surface-dim: #161217;
  surface-bright: #3c383e;
  surface-container-lowest: #100d12;
  surface-container-low: #1e1a20;
  surface-container: #221e24;
  surface-container-high: #2d292e;
  surface-container-highest: #383339;

  background:                 @surface-container-highest;
  trans-bg: rgba(34, 30, 36, 0.75);
  foreground:                 @on-surface;
  background-color:           transparent;
  alt-foreground: @on-primary;
  main: @primary;
  red: @error;
  lightfg:                  @on-surface-variant;
  lightbg:                    @surface-bright;
  border-color:               @outline-variant;

  normal-foreground:          @foreground;
  normal-background:          transparent;

  selected-normal-foreground: @alt-foreground;
  selected-normal-background: @main;

  selected-active-foreground: @alt-foreground;
  selected-active-background: @main;

  selected-urgent-foreground: @background;
  selected-urgent-background: @red;

  active-foreground:          @main;
  active-background:          @background;

  urgent-foreground:          @red;
  urgent-background:          @background;

  alternate-normal-foreground: @foreground;
  alternate-normal-background: transparent;

  alternate-active-foreground: @main;
  alternate-active-background: @main;

  alternate-urgent-foreground: @red;
  alternate-urgent-background: @lightbg;

  separatorcolor:             @main;

}
