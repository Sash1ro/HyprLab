* {
  primary: #feb876;
  primary-fixed: #ffdcbf;
  primary-fixed-dim: #feb876;
  on-primary: #4b2800;
  on-primary-fixed: #2d1600;
  on-primary-fixed-variant: #6a3b02;
  primary-container: #6a3b02;
  on-primary-container: #ffdcbf;
  secondary: #e2c0a4;
  secondary-fixed: #ffdcbf;
  secondary-fixed-dim: #e2c0a4;
  on-secondary: #412c18;
  on-secondary-fixed: #291806;
  on-secondary-fixed-variant: #59422d;
  secondary-container: #59422d;
  on-secondary-container: #ffdcbf;
  tertiary: #c1cc99;
  tertiary-fixed: #dde8b3;
  tertiary-fixed-dim: #c1cc99;
  on-tertiary: #2c340f;
  on-tertiary-fixed: #171e00;
  on-tertiary-fixed-variant: #424a23;
  tertiary-container: #424a23;
  on-tertiary-container: #dde8b3;
  error: #ffb4ab;
  on-error: #690005;
  error-container: #93000a;
  on-error-container: #ffdad6;
  surface: #19120c;
  on-surface: #efe0d5;
  on-surface-variant: #d5c3b6;
  outline: #9e8e81;
  outline-variant: #51443a;
  shadow: #000000;
  scrim: #000000;
  inverse-surface: #efe0d5;
  inverse-on-surface: #372f28;
  inverse-primary: #86521a;
  surface-dim: #19120c;
  surface-bright: #403830;
  surface-container-lowest: #130d07;
  surface-container-low: #211a14;
  surface-container: #261e18;
  surface-container-high: #312822;
  surface-container-highest: #3c332c;

  background:                 @surface-container-highest;
  trans-bg: rgba(38, 30, 24, 0.75);
  foreground:                 @on-surface;
  background-color:           transparent;
  alt-foreground: @on-primary;
  main: @primary;
  red: @error;
  lightfg:                  @on-surface-variant;
  lightbg:                    @surface-bright;
  border-color:               @outline-variant;

  normal-foreground:          @foreground;
  normal-background:          transparent;

  selected-normal-foreground: @alt-foreground;
  selected-normal-background: @main;

  selected-active-foreground: @alt-foreground;
  selected-active-background: @main;

  selected-urgent-foreground: @background;
  selected-urgent-background: @red;

  active-foreground:          @main;
  active-background:          @background;

  urgent-foreground:          @red;
  urgent-background:          @background;

  alternate-normal-foreground: @foreground;
  alternate-normal-background: transparent;

  alternate-active-foreground: @main;
  alternate-active-background: @main;

  alternate-urgent-foreground: @red;
  alternate-urgent-background: @lightbg;

  separatorcolor:             @main;

}
