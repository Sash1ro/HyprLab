* {
  primary: #99ccfa;
  primary-fixed: #cce5ff;
  primary-fixed-dim: #99ccfa;
  on-primary: #003351;
  on-primary-fixed: #001d31;
  on-primary-fixed-variant: #074b72;
  primary-container: #074b72;
  on-primary-container: #cce5ff;
  secondary: #b8c8da;
  secondary-fixed: #d4e4f6;
  secondary-fixed-dim: #b8c8da;
  on-secondary: #23323f;
  on-secondary-fixed: #0d1d2a;
  on-secondary-fixed-variant: #394857;
  secondary-container: #394857;
  on-secondary-container: #d4e4f6;
  tertiary: #d1bfe7;
  tertiary-fixed: #eddcff;
  tertiary-fixed-dim: #d1bfe7;
  on-tertiary: #372a4a;
  on-tertiary-fixed: #221534;
  on-tertiary-fixed-variant: #4e4161;
  tertiary-container: #4e4161;
  on-tertiary-container: #eddcff;
  error: #ffb4ab;
  on-error: #690005;
  error-container: #93000a;
  on-error-container: #ffdad6;
  surface: #101418;
  on-surface: #e0e2e8;
  on-surface-variant: #c2c7ce;
  outline: #8c9198;
  outline-variant: #42474e;
  shadow: #000000;
  scrim: #000000;
  inverse-surface: #e0e2e8;
  inverse-on-surface: #2d3135;
  inverse-primary: #2c638b;
  surface-dim: #101418;
  surface-bright: #36393e;
  surface-container-lowest: #0b0f12;
  surface-container-low: #181c20;
  surface-container: #1c2024;
  surface-container-high: #272a2e;
  surface-container-highest: #313539;

  background:                 @surface-container-highest;
  trans-bg: rgba(28, 32, 36, 0.75);
  foreground:                 @on-surface;
  background-color:           transparent;
  alt-foreground: @on-primary;
  main: @primary;
  red: @error;
  lightfg:                  @on-surface-variant;
  lightbg:                    @surface-bright;
  border-color:               @outline-variant;

  normal-foreground:          @foreground;
  normal-background:          transparent;

  selected-normal-foreground: @alt-foreground;
  selected-normal-background: @main;

  selected-active-foreground: @alt-foreground;
  selected-active-background: @main;

  selected-urgent-foreground: @background;
  selected-urgent-background: @red;

  active-foreground:          @main;
  active-background:          @background;

  urgent-foreground:          @red;
  urgent-background:          @background;

  alternate-normal-foreground: @foreground;
  alternate-normal-background: transparent;

  alternate-active-foreground: @main;
  alternate-active-background: @main;

  alternate-urgent-foreground: @red;
  alternate-urgent-background: @lightbg;

  separatorcolor:             @main;

}
