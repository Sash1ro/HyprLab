* {
  primary: #c3c0ff;
  primary-fixed: #e2dfff;
  primary-fixed-dim: #c3c0ff;
  on-primary: #2b2a60;
  on-primary-fixed: #16134a;
  on-primary-fixed-variant: #424178;
  primary-container: #424178;
  on-primary-container: #e2dfff;
  secondary: #c7c4dd;
  secondary-fixed: #e3e0f9;
  secondary-fixed-dim: #c7c4dd;
  on-secondary: #2f2e42;
  on-secondary-fixed: #1a1a2c;
  on-secondary-fixed-variant: #464559;
  secondary-container: #464559;
  on-secondary-container: #e3e0f9;
  tertiary: #eab9d2;
  tertiary-fixed: #ffd8ea;
  tertiary-fixed-dim: #eab9d2;
  on-tertiary: #472639;
  on-tertiary-fixed: #2f1124;
  on-tertiary-fixed-variant: #603c50;
  tertiary-container: #603c50;
  on-tertiary-container: #ffd8ea;
  error: #ffb4ab;
  on-error: #690005;
  error-container: #93000a;
  on-error-container: #ffdad6;
  surface: #131318;
  on-surface: #e5e1e9;
  on-surface-variant: #c8c5d0;
  outline: #928f9a;
  outline-variant: #47464f;
  shadow: #000000;
  scrim: #000000;
  inverse-surface: #e5e1e9;
  inverse-on-surface: #303036;
  inverse-primary: #5a5892;
  surface-dim: #131318;
  surface-bright: #39383f;
  surface-container-lowest: #0e0e13;
  surface-container-low: #1b1b21;
  surface-container: #201f25;
  surface-container-high: #2a292f;
  surface-container-highest: #35343a;

  background:                 @surface-container-highest;
  trans-bg: rgba(32, 31, 37, 0.75);
  foreground:                 @on-surface;
  background-color:           transparent;
  alt-foreground: @on-primary;
  main: @primary;
  red: @error;
  lightfg:                  @on-surface-variant;
  lightbg:                    @surface-bright;
  border-color:               @outline-variant;

  normal-foreground:          @foreground;
  normal-background:          transparent;

  selected-normal-foreground: @alt-foreground;
  selected-normal-background: @main;

  selected-active-foreground: @alt-foreground;
  selected-active-background: @main;

  selected-urgent-foreground: @background;
  selected-urgent-background: @red;

  active-foreground:          @main;
  active-background:          @background;

  urgent-foreground:          @red;
  urgent-background:          @background;

  alternate-normal-foreground: @foreground;
  alternate-normal-background: transparent;

  alternate-active-foreground: @main;
  alternate-active-background: @main;

  alternate-urgent-foreground: @red;
  alternate-urgent-background: @lightbg;

  separatorcolor:             @main;

}
