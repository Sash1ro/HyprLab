* {
  primary: #87d6bc;
  primary-fixed: #a3f2d8;
  primary-fixed-dim: #87d6bc;
  on-primary: #00382b;
  on-primary-fixed: #002018;
  on-primary-fixed-variant: #005140;
  primary-container: #005140;
  on-primary-container: #a3f2d8;
  secondary: #b2ccc1;
  secondary-fixed: #cee9dd;
  secondary-fixed-dim: #b2ccc1;
  on-secondary: #1d352d;
  on-secondary-fixed: #072019;
  on-secondary-fixed-variant: #344c43;
  secondary-container: #344c43;
  on-secondary-container: #cee9dd;
  tertiary: #a8cbe2;
  tertiary-fixed: #c4e7ff;
  tertiary-fixed-dim: #a8cbe2;
  on-tertiary: #0d3446;
  on-tertiary-fixed: #001e2c;
  on-tertiary-fixed-variant: #284b5e;
  tertiary-container: #284b5e;
  on-tertiary-container: #c4e7ff;
  error: #ffb4ab;
  on-error: #690005;
  error-container: #93000a;
  on-error-container: #ffdad6;
  surface: #0f1512;
  on-surface: #dee4e0;
  on-surface-variant: #bfc9c3;
  outline: #89938e;
  outline-variant: #3f4945;
  shadow: #000000;
  scrim: #000000;
  inverse-surface: #dee4e0;
  inverse-on-surface: #2b322f;
  inverse-primary: #126b56;
  surface-dim: #0f1512;
  surface-bright: #343b38;
  surface-container-lowest: #090f0d;
  surface-container-low: #171d1a;
  surface-container: #1b211e;
  surface-container-high: #252b29;
  surface-container-highest: #303633;

  background:                 @surface-container-highest;
  trans-bg: rgba(27, 33, 30, 0.75);
  foreground:                 @on-surface;
  background-color:           transparent;
  alt-foreground: @on-primary;
  main: @primary;
  red: @error;
  lightfg:                  @on-surface-variant;
  lightbg:                    @surface-bright;
  border-color:               @outline-variant;

  normal-foreground:          @foreground;
  normal-background:          transparent;

  selected-normal-foreground: @alt-foreground;
  selected-normal-background: @main;

  selected-active-foreground: @alt-foreground;
  selected-active-background: @main;

  selected-urgent-foreground: @background;
  selected-urgent-background: @red;

  active-foreground:          @main;
  active-background:          @background;

  urgent-foreground:          @red;
  urgent-background:          @background;

  alternate-normal-foreground: @foreground;
  alternate-normal-background: transparent;

  alternate-active-foreground: @main;
  alternate-active-background: @main;

  alternate-urgent-foreground: @red;
  alternate-urgent-background: @lightbg;

  separatorcolor:             @main;

}
