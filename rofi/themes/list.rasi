@import "colors.rasi"
@import "alt.rasi"


configuration {
    show-icons: false;
}

window {
    location:       center;
    anchor:         center;
    width: 15%;
    layout: vertical;
}

listbox {
    margin: 0px;
    children: ["inputbar","message","listview"];
}
message {
    border: 0;
    margin: 2px 10px 2px 10px;
    vertical-align: 0;
}

listview {
    columns: 1;
    lines: 6;
    orientation: vertical;
}

element {
    margin: 0;
    padding: 10px;
}

element-text {
    horizontal-align: 0;
}
inputbar {
    children:   ["prompt", "entry"];
}

prompt {
    vertical-align: 0;
    padding: 5px;
    text-color:        @normal-foreground;
    spacing:           0;
}

entry {
    placeholder:       "search";
}