@import "colors.rasi"
@import "config.rasi"

configuration{
    show-icons: true;
    sidebar-mode: false;
    sort: true;
    /*sorting-method: "name";*/
    disable-history: true;
    alternate-row-color: false;
    fixed-height: false;
}

listview{
    dynamic:                     true;
    fixed-width: none;
    spacing: 0px;
    columns:                     6;
    lines: 1;
}

element-icon {
    vertical-align: 0.0;
    size: 26%;
    border-radius:  10px;
    padding:        0px;
    margin:         0px;
    spacing:        0px;
}

element-text {
    margin:              5px 0 5px 0;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

element{
    orientation: vertical;
    height: 0px;
    padding: 0;
    margin: 10px;
    spacing:0px;
    overflow: true;
}

element selected.normal {
    background-color: @main;
    color: @selected-normal-foreground;
}

window{
    location:       center;
    anchor:         center;
    x-offset: 0;
    y-offset: 0;
    width: 90%; 
    border: 1px ;
}
